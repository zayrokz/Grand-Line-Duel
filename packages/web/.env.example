# Configuration web Firebase (Console Firebase → Paramètres du projet → Vos applications).
# Ces valeurs sont PUBLIQUES par nature (elles finissent dans le JavaScript servi au navigateur) ;
# la sécurité repose sur les règles Firestore, l'authentification et App Check.
# Copiez ce fichier en `.env.local` (ignoré par git).
VITE_FIREBASE_API_KEY=
# Utilisez de préférence votre domaine d'hébergement (ex. mon-projet.web.app) pour la connexion Google.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Clé de site reCAPTCHA Enterprise pour App Check (publique).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Développement local : `true` pour utiliser les émulateurs (aucun projet réel nécessaire).
VITE_USE_EMULATORS=false
# Jeton de débogage App Check (développement uniquement, à enregistrer dans la console).
VITE_APPCHECK_DEBUG_TOKEN=
